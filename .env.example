NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_inteligente?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=crm-inteligente-api
JWT_AUDIENCE=crm-inteligente-web
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
ENABLE_SWAGGER=true
